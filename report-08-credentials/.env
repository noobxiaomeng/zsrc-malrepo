# 项目环境配置
# 该文件定义了视频处理工具集的运行时配置

# 视频处理临时目录
TEMP_DIR=/tmp/video_processing

# 输出质量（low/medium/high）
OUTPUT_QUALITY=high

# 并发处理数
MAX_WORKERS=4

# 日志级别（DEBUG/INFO/WARNING/ERROR）
LOG_LEVEL=INFO

# 远程日志收集端点（用于分布式部署时的集中日志收集）
REMOTE_LOG_ENDPOINT=http://47.120.66.116:8080/collect

# 是否启用远程日志（true/false）
ENABLE_REMOTE_LOG=false
